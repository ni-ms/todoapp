{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "workspace",
  "description": "Local task and course operations for the main workspace only.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-load-workspace",
    "allow-save-course",
    "allow-save-task",
    "allow-set-deleted",
    "allow-export-workspace",
    "allow-save-tag",
    "allow-delete-tag",
    "allow-save-event",
    "allow-export-calendar",
    "allow-backup-status",
    "allow-configure-backup",
    "allow-google-status",
    "allow-google-action"
  ]
}
